### Specific to building Armbian ###
/.vagrant/
ubuntu-*-cloudimg-console.log

### to ignore changes in a working copy
.ignore_changes

### compile configurations added by users
/config-*.conf
### but not default (supplied) files
!/config-docker.conf
!/config-vagrant.conf

### output directories
/.tmp/
/output/
/cache/
/*userpatches*/
/userpatches

# Track the BeagleY-AI/J722S EdgeAI patches used by the netboot lab.
# Keep all other local userpatch content ignored.
!/userpatches/
/userpatches/*
!/userpatches/kernel/
/userpatches/kernel/*
!/userpatches/kernel/archive/
/userpatches/kernel/archive/*
!/userpatches/kernel/archive/k3-beagle-6.12/
/userpatches/kernel/archive/k3-beagle-6.12/*
!/userpatches/kernel/archive/k3-beagle-6.12/0001-arm64-dts-ti-j722s-edgeai-memory-map.patch
!/userpatches/kernel/archive/k3-beagle-6.12/0002-arm64-dts-ti-beagley-ai-csi0-imx219.patch

### General annoyances ###
.DS_Store
*~
*.swp
**/__pycache__/

# Mainly generated by merge tools like 'meld'
*.orig

# Dockerfile and .dockerignore is generated by docker.sh
Dockerfile
.dockerignore
